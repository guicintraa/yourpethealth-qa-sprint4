{
  "info": {
    "_postman_id": "8c4eb381-e30f-46d7-ae89-adbca5634d49",
    "name": "YourPetHealth - Testes Automatizados da API",
    "description": "Testes automatizados de integração da API Java do YourPetHealth. Cada requisição tem o código do caso de teste manual que automatiza (CTxx.y), ligado à história de usuário que ele valida no Azure Boards. Execute na ordem, pelo Collection Runner. Cada execução cria usuários novos (sufixo runId), para que a coleção possa ser rodada várias vezes; os demais dados são fixos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 · Preparação - Confirmar que a API está no ar",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/veterinarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "veterinarios"
          ]
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Passo de preparação de dados para os testes seguintes."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Servidor respondeu (sem erro 5xx)', () => pm.expect(pm.response.code).to.be.below(500));",
              "// Guarda o relógio do servidor (campo timestamp do erro padronizado) para os testes que dependem de horário",
              "try { const ts = pm.response.json().timestamp; if (ts) pm.collectionVariables.set('relogioServidor', ts); } catch (e) {}"
            ]
          }
        }
      ]
    },
    {
      "name": "01 · CT01.2 - Criar conta de veterinário com CRMV",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bruno Vet Teste\",\n  \"email\": \"vet.{{runId}}@yourpet.test\",\n  \"senha\": \"Senha@123\",\n  \"telefone\": \"11933334444\",\n  \"perfil\": \"VETERINARIO\",\n  \"crmv\": \"{{crmvTeste}}\",\n  \"especialidade\": \"Clinica Geral\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        },
        "description": "Automatiza o caso de teste CT01.2 - Criar conta de veterinário com CRMV, que valida a história US01 - Como novo usuário, quero criar minha conta."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('runId', Date.now());",
              "// CRMV diferente a cada execução: a API não aceita dois veterinários com o mesmo CRMV",
              "pm.collectionVariables.set('crmvTeste', 'SP-' + String(Date.now()).slice(-5));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "",
              "pm.test('Retorna token e perfil VETERINARIO', () => {",
              "  const j = pm.response.json();",
              "  pm.expect(j.token).to.be.a('string').and.not.empty;",
              "  pm.expect(j.usuario.perfil).to.eql('VETERINARIO');",
              "  pm.expect(j.usuario.veterinarioId).to.not.be.null;",
              "  pm.expect(j.usuario.responsavelId).to.be.null;",
              "  pm.collectionVariables.set('vetToken', j.token);",
              "  pm.collectionVariables.set('vetId', j.usuario.veterinarioId);",
              "});"
            ]
          }
        }
      ]
    },
