            "api",
            "consultas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}},\n  \"tipo\": \"ROTINA\",\n  \"descricao\": \"Check-up semestral\",\n  \"data\": \"{{dataValida}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tutorToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Automatiza o caso de teste CT07.1 - Agendar consulta válida, que valida a história US07 - Como responsável, quero agendar uma consulta para meu pet."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pad = n => String(n).padStart(2, '0');",
              "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;",
              "const proximo = (diaSemana, hora) => {",
              "  const d = new Date();",
              "  let delta = (diaSemana - d.getDay() + 7) % 7;",
              "  if (delta < 2) delta += 7;  // no minimo 2 dias a frente (cancelamento exige 24h)",
              "  d.setDate(d.getDate() + delta);",
              "  d.setHours(hora, 0, 0, 0);",
              "  return d;",
              "};",
              "pm.collectionVariables.set('dataValida', fmt(proximo(1, 10)));  // proxima segunda, 10:00"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "",
              "pm.test('Consulta criada como AGENDADA', () => {",
              "  const j = pm.response.json();",
              "  pm.expect(j.status).to.eql('AGENDADA');",
              "  pm.expect(j.petId).to.eql(pm.collectionVariables.get('petId') * 1);",
              "  pm.expect(j.observacoes).to.be.null;",
              "  pm.collectionVariables.set('consultaId', j.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "11 · CT07.2 - Agendar com menos de 2 horas de antecedência",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/consultas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "consultas"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"petId\": {{petId}},\n  \"veterinarioId\": {{vetId}},\n  \"tipo\": \"ROTINA\",\n  \"descricao\": \"Teste de antecedencia\",\n  \"data\": \"{{dataUmaHora}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tutorToken}}",
              "type": "string"
            }
          ]
        },
        "description": "Automatiza o caso de teste CT07.2 - Agendar com menos de 2 horas de antecedência, que valida a história US07 - Como responsável, quero agendar uma consulta para meu pet. A data é calculada 1 hora à frente do relógio do próprio servidor, lido na requisição 00."
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const pad = n => String(n).padStart(2, '0');",
              "const fmt = d => `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}:00`;",
              "const proximo = (diaSemana, hora) => {",
              "  const d = new Date();",
              "  let delta = (diaSemana - d.getDay() + 7) % 7;",
              "  if (delta < 2) delta += 7;  // no minimo 2 dias a frente (cancelamento exige 24h)",
              "  d.setDate(d.getDate() + delta);",
              "  d.setHours(hora, 0, 0, 0);",
              "  return d;",
              "};",
              "// Base: o relógio do próprio servidor, guardado na requisição 00. Assim o teste vale qualquer que seja o fuso do servidor.",
              "const ts = pm.collectionVariables.get('relogioServidor');",
              "const base = ts ? new Date(ts) : new Date();",
              "base.setMinutes(base.getMinutes() + 60, 0, 0);",
              "pm.collectionVariables.set('dataUmaHora', fmt(base));"
            ]
