    {
      "id": "0ba89b2e-32fc-5f74-8921-b7433c18acdf",
      "name": "CT01.1 - Criar conta de responsável com dados válidos",
      "commands": [
        {
          "id": "97447246-e931-540b-bed3-3d4fad499f39",
          "comment": "Abre o app no navegador",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "6f3faa13-2ca0-50f1-89e2-b7c80557293f",
          "comment": "Pré-condição: nenhuma sessão ativa (apaga o login guardado no navegador)",
          "command": "executeScript",
          "target": "localStorage.clear(); sessionStorage.clear();",
          "targets": [],
          "value": ""
        },
        {
          "id": "f6101514-73c3-5c8c-ad87-fa286bea6a24",
          "comment": "Recarrega a tela de login já sem sessão",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "00da2ec0-87fd-579f-a6c5-8d08e0ce1a4b",
          "comment": "Espera a tela de login aparecer",
          "command": "waitForElementVisible",
          "target": "linkText=Não tem conta? Cadastre-se",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "5055e3c4-f624-5cc1-88b9-a9ed2dcc585a",
          "comment": "Passo 1: tocar no link para criar conta",
          "command": "click",
          "target": "linkText=Não tem conta? Cadastre-se",
          "targets": [],
          "value": ""
        },
        {
          "id": "c754dd04-fac7-5dbe-9823-f0fc74d2295c",
          "comment": "Espera o formulário de cadastro",
          "command": "waitForElementVisible",
          "target": "css=input[placeholder=\"Seu nome\"]",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "f0a74c06-3af4-5cf2-b27f-64bd07c5153b",
          "comment": "Gera um e-mail novo a cada execução e guarda na variável email, para o teste poder ser repetido",
          "command": "executeScript",
          "target": "return 'tutor.ui' + Date.now() + '@yourpet.test'",
          "targets": [],
          "value": "email"
        },
        {
          "id": "2e0fd14a-f14b-51a8-b2e5-863fdeefc154",
          "comment": "Passo 2: nome",
          "command": "type",
          "target": "css=input[placeholder=\"Seu nome\"]",
          "targets": [],
          "value": "Ana Tutora Teste"
        },
        {
          "id": "31f0de8f-1736-52f5-b815-30da8bfe7d49",
          "comment": "Passo 2: e-mail (variável gerada acima)",
          "command": "type",
          "target": "xpath=(//input[@placeholder='voce@email.com'])[last()]",
          "targets": [],
          "value": "${email}"
        },
        {
          "id": "a086bd3f-5dd3-5d65-b0ff-5d3ed0d292d8",
          "comment": "Passo 2: telefone",
          "command": "type",
          "target": "css=input[placeholder=\"11911111111\"]",
          "targets": [],
          "value": "11911112222"
        },
        {
          "id": "24d953fb-9dec-53ea-b771-067fd80e8778",
          "comment": "Passo 2: senha",
          "command": "type",
          "target": "css=input[placeholder=\"Mínimo de 8 caracteres\"]",
          "targets": [],
          "value": "Senha@123"
        },
        {
          "id": "9c8f284e-ca46-53ae-b6c7-28592b381421",
          "comment": "Passo 2: confirmação da senha",
          "command": "type",
          "target": "css=input[placeholder=\"Repita a senha\"]",
          "targets": [],
          "value": "Senha@123"
        },
        {
          "id": "0c9ba738-866e-5caf-ad13-c0c39a14eb1e",
          "comment": "Passo 3: selecionar o perfil Responsável (Tutor)",
          "command": "click",
          "target": "xpath=//div[text()='Tutor']",
          "targets": [],
          "value": ""
        },
        {
          "id": "0d7ef577-019b-51a8-8e66-8f2ccffa7ab7",
          "comment": "Passo 4: tocar em Cadastrar",
          "command": "click",
          "target": "xpath=//div[text()='Cadastrar']",
          "targets": [],
          "value": ""
        },
        {
          "id": "b84c0f96-adf0-5d1f-8a8c-864374f3548f",
          "comment": "Resultado esperado: a conta é criada e abre a tela inicial",
          "command": "waitForElementVisible",
          "target": "xpath=//div[normalize-space(.)='Olá, Ana Tutora Teste']",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "a6821fb5-bbef-538a-aca5-7f416d2bb616",
          "comment": "A saudação mostra o nome cadastrado",
          "command": "assertText",
          "target": "xpath=//div[normalize-space(.)='Olá, Ana Tutora Teste']",
          "targets": [],
          "value": "Olá, Ana Tutora Teste"
        },
        {
          "id": "1811947b-7823-54c9-b9f1-3be3f4d46cd6",
          "comment": "É a tela inicial do responsável",
          "command": "assertElementPresent",
          "target": "xpath=//div[text()='Aqui está o resumo da saúde dos seus pets.']",
          "targets": [],
          "value": ""
        }
      ]
